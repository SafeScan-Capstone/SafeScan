# Server Configuration
NODE_ENV=development
PORT=4000

# Database Configuration (PostgreSQL)
# Use DATABASE_URL for cloud databases (e.g., Render), or individual connection parameters for local
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGUSER=your_pg_user
PGPASSWORD=your_pg_password
PGDATABASE=safescan

# Authentication
JWT_SECRET=your_jwt_secret_here

# CORS
CORS_ORIGIN=http://localhost:3000

# AI Service Configuration
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=your_openai_key_here
# Fallback: You can also use OPENAI_API_KEY instead of AI_API_KEY
# OPENAI_API_KEY=your_openai_key_here

# Optional: Legacy AI service configuration (if using external AI service)
AI_SERVICE_URL=
AI_SERVICE_API_KEY=
AI_TIMEOUT_MS=10000

# Optional: OCR Configuration
OCR_SPACE_API_KEY=your_ocr_space_api_key

# Optional: Google Sheets Integration
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials.json

# Optional: Render-specific (auto-set on Render)
RENDER=
